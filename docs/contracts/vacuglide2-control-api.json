  "policy_differences": {
    "control": "local pairing and explicit compatibility/script opt-in; panel lease is separate from external-client STOP",
    "limits": "32 ordinary HTTP handlers, two uploads, 32 event subscribers; overload returns 429; STOP bypasses ordinary/upload admission",
    "credentials": "device token and its SSE connection expire on device disconnect; independent local key retains offline access",
    "storage": "bounded local stores; atomic state commits; native script playback requires maxSpeed 100",
    "network": "script URL fetches require explicit origins; no redirects; no OTA"
  },
  "acceptance": "Source/virtual protocol tests do not establish physical acceptance; see docs/en/project.md and docs/ru/project.md"
